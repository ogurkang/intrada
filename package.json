{
  "name": "intrada",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-gelistirmeler.mjs && next dev",
    "dev:3001": "next dev -p 3001",
    "gen:gelistirmeler": "node scripts/generate-gelistirmeler.mjs",
    "build": "node scripts/generate-gelistirmeler.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "bulk-auth-users": "node --env-file=.env.local scripts/bulk-create-auth-users.mjs",
    "bulk-auth-users:dry": "node --env-file=.env.local scripts/bulk-create-auth-users.mjs --dry",
    "bulk-auth-users:reset": "node --env-file=.env.local scripts/bulk-create-auth-users.mjs --reset-existing",
    "bulk-auth-users:reset:dry": "node --env-file=.env.local scripts/bulk-create-auth-users.mjs --reset-existing --dry"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "archiver": "^7.0.1",
      "unzipper": "^0.12.3",
      "fast-csv": "^5.0.5"
    },
    "glob": "^13.0.6"
  }
}
